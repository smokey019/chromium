From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: REBA <noreply@reba.smokey.gg>
Date: Sat, 24 Oct 2026 00:00:00 +0000
Subject: [PATCH] Support the $popup filter option and a popup request type

The ad blocker has to block windows that pages open on their own, which
EasyList and uBlock Origin do with $popup rules. The crate dropped every
filter with that option as unrecognised. Add RequestType::Popup, the
FROM_POPUP mask bit (part of $all and of hostname-only rules, like
documents) and the option itself.
---
diff --git a/third_party/rust/chromium_crates_io/vendor/adblock-v0_13/src/filters/abstract_network.rs b/third_party/rust/chromium_crates_io/vendor/adblock-v0_13/src/filters/abstract_network.rs
index 840615d..56375b5 100644
--- a/third_party/rust/chromium_crates_io/vendor/adblock-v0_13/src/filters/abstract_network.rs
+++ b/third_party/rust/chromium_crates_io/vendor/adblock-v0_13/src/filters/abstract_network.rs
@@ -80,6 +80,7 @@ pub(crate) enum NetworkFilterOption<'a> {
     Removeparam(&'a str),
     Generichide,
     Document,
+    Popup,
     Image(bool),
     Media(bool),
     Object(bool),
@@ -100,6 +101,7 @@ impl NetworkFilterOption<'_> {
         matches!(
             self,
             Self::Document
+                | Self::Popup
                 | Self::Image(..)
                 | Self::Media(..)
                 | Self::Object(..)
@@ -260,6 +262,9 @@ fn parse_filter_options<'a>(
             ("generichide", false) | ("ghide", false) => NetworkFilterOption::Generichide,
             ("document", true) | ("doc", true) => return Err(NetworkFilterError::NegatedDocument),
             ("document", false) | ("doc", false) => NetworkFilterOption::Document,
+            // A negated popup type would match nothing useful.
+            ("popup", true) => return Err(NetworkFilterError::UnrecognisedOption),
+            ("popup", false) => NetworkFilterOption::Popup,
             ("image", negated) => NetworkFilterOption::Image(!negated),
             ("media", negated) => NetworkFilterOption::Media(!negated),
             ("object", negated) | ("object-subrequest", negated) => {
diff --git a/third_party/rust/chromium_crates_io/vendor/adblock-v0_13/src/filters/network.rs b/third_party/rust/chromium_crates_io/vendor/adblock-v0_13/src/filters/network.rs
index 11e253b..5eee654 100644
--- a/third_party/rust/chromium_crates_io/vendor/adblock-v0_13/src/filters/network.rs
+++ b/third_party/rust/chromium_crates_io/vendor/adblock-v0_13/src/filters/network.rs
@@ -120,6 +120,9 @@ bitflags::bitflags! {
         const FROM_HTTPS = 1 << 12;
         const IS_IMPORTANT = 1 << 13;
         const MATCH_CASE = 1 << 14;
+        // New windows opened by pages (`$popup`). Like documents, not implied by
+        // negated types, but part of `$all` and of hostname-only rules.
+        const FROM_POPUP = 1 << 15;
         const THIRD_PARTY = 1 << 16;
         const FIRST_PARTY = 1 << 17;
         // Full document rules are not implied by negated types.
@@ -161,7 +164,8 @@ bitflags::bitflags! {
         // Includes all remaining types, not implied by any negated types.
         // TODO Could also include popup, inline-font, inline-script
         const FROM_ALL_TYPES = Self::FROM_NETWORK_TYPES.bits() |
-            Self::FROM_DOCUMENT.bits();
+            Self::FROM_DOCUMENT.bits() |
+            Self::FROM_POPUP.bits();
 
         // Unless filter specifies otherwise, all these options are set by default
         const DEFAULT_OPTIONS = Self::FROM_NETWORK_TYPES.bits() |
@@ -269,6 +273,9 @@ pub trait NetworkFilterMaskHelper {
             NetworkFilterMask::FROM_DOCUMENT => {
                 self.has_flag(NetworkFilterMask::FROM_DOCUMENT) || self.is_exception()
             }
+            NetworkFilterMask::FROM_POPUP => {
+                self.has_flag(NetworkFilterMask::FROM_POPUP) || self.is_exception()
+            }
             mask => self.has_flag(mask),
         }
     }
@@ -312,6 +319,7 @@ impl From<&request::RequestType> for NetworkFilterMask {
             request::RequestType::Object => NetworkFilterMask::FROM_OBJECT,
             request::RequestType::Other => NetworkFilterMask::FROM_OTHER,
             request::RequestType::Ping => NetworkFilterMask::FROM_PING,
+            request::RequestType::Popup => NetworkFilterMask::FROM_POPUP,
             request::RequestType::Script => NetworkFilterMask::FROM_SCRIPT,
             request::RequestType::Stylesheet => NetworkFilterMask::FROM_STYLESHEET,
             request::RequestType::Subdocument => NetworkFilterMask::FROM_SUBDOCUMENT,
@@ -626,6 +634,9 @@ impl<'a> NetworkFilter<'a> {
                     NetworkFilterOption::Document => {
                         cpt_mask_positive.set(NetworkFilterMask::FROM_DOCUMENT, true)
                     }
+                    NetworkFilterOption::Popup => {
+                        cpt_mask_positive.set(NetworkFilterMask::FROM_POPUP, true)
+                    }
                     NetworkFilterOption::Image(enabled) => apply_content_type!(FROM_IMAGE, enabled),
                     NetworkFilterOption::Media(enabled) => apply_content_type!(FROM_MEDIA, enabled),
                     NetworkFilterOption::Object(enabled) => {
diff --git a/third_party/rust/chromium_crates_io/vendor/adblock-v0_13/src/request.rs b/third_party/rust/chromium_crates_io/vendor/adblock-v0_13/src/request.rs
index 72e2638..a63119e 100644
--- a/third_party/rust/chromium_crates_io/vendor/adblock-v0_13/src/request.rs
+++ b/third_party/rust/chromium_crates_io/vendor/adblock-v0_13/src/request.rs
@@ -51,6 +51,8 @@ pub enum RequestType {
     Object,
     Other,
     Ping,
+    /// A new window or tab opened by a page (`$popup`).
+    Popup,
     Script,
     Stylesheet,
     Subdocument,
@@ -92,6 +94,7 @@ fn cpt_match_type(cpt: &str) -> RequestType {
         "media" => RequestType::Media,
         "object" | "object_subrequest" => RequestType::Object,
         "ping" => RequestType::Ping,
+        "popup" => RequestType::Popup,
         "script" => RequestType::Script,
         "stylesheet" => RequestType::Stylesheet,
         "sub_frame" | "subdocument" => RequestType::Subdocument,
